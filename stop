# sysmon: полноэкранный монитор этой машины
# xeon e3-1230 v2, rx 580, nct6776, zram, sda + md0
# датчики ищутся по name, индексы hwmon не зашиты
# кулеры крутит готовый /usr/local/bin/fan, в sysfs отсюда не пишем

import os
import signal
import subprocess
import sys
import time
